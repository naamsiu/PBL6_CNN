# Server / camera / detector settings from the original project
WEB_SERVER_URL=http://10.177.62.189:8000
DEVICE_API_KEY=
DEVICE_CODE=PI-001
CAMERA_BACKEND=opencv
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
# If your USB webcam supports MJPG at higher resolutions, set CAMERA_FOURCC=MJPG
CAMERA_FOURCC=
NANODET_MODEL=models/nanodet_face_512_fp32.onnx
LANDMARK_MODEL=models/landmark_v4_2_pi_256_f3f4_2conv_pose3.onnx
ORT_THREADS=4
NANODET_SCORE_THRESHOLD=0.30
NANODET_NMS_THRESHOLD=0.50
AUTH_STABLE_FRAMES=6
AUTH_FACE_CONFIDENCE=0.70
AUTH_MIN_IOU=0.40
AUTH_RETRY_SECONDS=2.0
JPEG_QUALITY=85
MAX_UPLOAD_WIDTH=1280
MAX_UPLOAD_HEIGHT=720
MAX_JPEG_BYTES=2097152
LANDMARK_CROP_SCALE=1.33
LANDMARK_CROP_Y_SHIFT=0.035
NANODET_CENTER_ZOOM=1.25
FACE_BOX_PAD_X=0.06
FACE_BOX_PAD_TOP=0.05
FACE_BOX_PAD_BOTTOM=0.16

EYE_MIN_CLOSED_SECONDS=0.30
DROWSY_CLOSED_SECONDS=1.50
# Chi ap dung de go canh bao DROWSY, khong lam tre trang thai AWAKE
EYE_RECOVER_SECONDS=1.00
EYE_NOD_COMBO_SECONDS=0.70
MAX_OBSERVATION_GAP_SECONDS=0.50
PERCLOS_WINDOW_SECONDS=30
PERCLOS_MIN_SECONDS=10
PERCLOS_MIN_COVERAGE=0.60
PERCLOS_THRESHOLD=0.20
PERCLOS_REARM_THRESHOLD=0.15
POSE_CALIBRATION_SECONDS=2.0
CALIBRATION_MIN_SAMPLES=8
YAWN_BASELINE_RATIO=2.0
YAWN_MIN_INCREASE=0.12
YAWN_ABSOLUTE_MIN_RATIO=0.35
YAWN_MIN_SECONDS=0.70
YAWN_COUNT_THRESHOLD=2
YAWN_WINDOW_SECONDS=60
PITCH_DOWN_SIGN=-1
HEAD_PITCH_DOWN_DEG=20
HEAD_NOD_SECONDS=0.45
HEAD_DROP_THRESHOLD=0.15
YAW_AWAY_DEG=35
PITCH_AWAY_DOWN_DEG=30
LOOK_AWAY_SECONDS=2.0
LOOK_AWAY_CRITICAL_SECONDS=5.0
AWAY_RECOVER_SECONDS=0.40
EYE_LOG=0
# Landmark-only eye geometry; tune on validation video
EAR_CLOSED_THRESHOLD=0.16
EAR_OPEN_THRESHOLD=0.22
EAR_MIN_WIDTH_PX=8
# Look straight with both eyes open for 3 seconds at each session start.
# Per-eye OPEN/CLOSED uses short hysteresis, median EAR and consecutive evidence.
# UNKNOWN only means unreliable/missing geometry; never a normal EAR interval.
# EAR is normalized by eye width. Face box scale changes quality gates, not EAR itself.
EAR_CALIBRATION_SECONDS=3.0
EAR_CALIBRATION_MIN_SAMPLES=15
EAR_CALIBRATION_MAX_POSE=15
EAR_PERSONAL_CLOSED_RATIO=0.68
EAR_PERSONAL_OPEN_RATIO=0.74
EAR_EXPECTED_WIDTH_MIN_RATIO=0.55
EAR_STABILITY_FRAMES=3
EAR_CONFIRM_FRAMES=2
EAR_FILTER_FRAMES=3
EAR_SHAPE_MIN_TOLERANCE=0.14
EAR_MAX_YAW=40
EAR_MAX_PITCH=35
EAR_MAX_ROLL=35
SHOW_LANDMARKS=0
SHOW_EYE_DEBUG=0

